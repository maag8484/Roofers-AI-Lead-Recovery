# =====================================================================
# FRONTEND (Vite) — only VITE_PUBLIC_* vars are exposed to the browser.
# Copy this file to .env and fill in your values.
# =====================================================================

# Supabase (Project Settings → API)
VITE_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe (publishable key only on the frontend)
VITE_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Google (client id is safe to expose; secret is NOT)
VITE_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com


# =====================================================================
# EDGE FUNCTION SECRETS — set with the Supabase CLI, NOT in this .env:
#   supabase secrets set KEY=value
# Listed here only for reference. NEVER ship these to the browser.
# =====================================================================

# Auto-injected by Supabase into every function (do not set manually):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# Stripe — set as Supabase secrets (supabase secrets set …), NOT in this browser .env.
# Two sets of secrets + a mode flag let you switch test<->live without re-entering keys.
# STRIPE_MODE picks which set the edge functions use (default: test).
#   STRIPE_MODE=test   (default) -> uses the base names below
#   STRIPE_MODE=live             -> uses the *_LIVE names below
# TEST set:
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PRICE_ID=price_xxx              # the $299/month recurring price (test)
# STRIPE_WEBHOOK_SECRET=whsec_xxx        # signing secret of the TEST webhook endpoint
# LIVE set (set these before flipping STRIPE_MODE=live):
# STRIPE_SECRET_KEY_LIVE=sk_live_xxx
# STRIPE_PRICE_ID_LIVE=price_xxx         # the $299/month recurring price (live — differs from test)
# STRIPE_WEBHOOK_SECRET_LIVE=whsec_xxx   # signing secret of the LIVE webhook endpoint
# STRIPE_MODE=test

# Twilio
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx

# Google OAuth (web client)
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx
# GOOGLE_REDIRECT_URI=https://YOUR_PROJECT.supabase.co/functions/v1/google-oauth-callback

# Token encryption — 32 bytes, base64. Generate with:
#   openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=

# n8n integration
# N8N_VOICE_WEBHOOK_URL=https://your-n8n.com/webhook/voice
# N8N_SHARED_SECRET=a-long-random-string   # n8n sends this as X-Api-Key

# Vercel server-side variables for /api/audit-request (never VITE_PUBLIC_*):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# AUDIT_RATE_LIMIT_SALT=generate-with-openssl-rand-hex-32

# Phase 5: destination for the admin 'Send test email' button (falls back to the current admin's email if unset)
VITE_ADMIN_TEST_EMAIL=

# Phase 7 — production email
# Server-side (supabase secrets set): daily send cap for gmail-send. Read from
# admin_settings.daily_send_cap first; this env is the fallback. 0 = fail closed.
DAILY_SEND_CAP=500
# Feature flag for the example send site (customer went LIVE). Default OFF.
# Set to "true" to route that send through gmail-send.
VITE_USE_GMAIL_SEND_FOR_STATUS_LIVE=
